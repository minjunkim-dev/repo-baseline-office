{
  "name": "Allow pull_request_target for Review status",
  "enforcement": "active",
  "conditions": {
    "workflow_path": {
      "include": [
        ".github/workflows/review-status.yml"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "restrict_action_events",
      "parameters": {
        "allowed_events": [
          "issue_comment",
          "pull_request_target"
        ]
      }
    }
  ]
}
