{
 "runner": [
  "claude",
  "--setting-sources",
  "project",
  "--permission-mode",
  "dontAsk"
 ],
 "deny": [
  "Read(**/.env*)",
  "Edit(/{baseline}/*.md)",
  "Write(/{baseline}/*.md)",
  "Edit(/{baseline}/tools/**)",
  "Write(/{baseline}/tools/**)",
  "Edit(/{baseline}/prompts/**)",
  "Write(/{baseline}/prompts/**)",
  "Edit(/{baseline}/profiles/**)",
  "Write(/{baseline}/profiles/**)",
  "Edit(/{baseline}/templates/**)",
  "Write(/{baseline}/templates/**)",
  "Edit(/{baseline}/docs/**)",
  "Write(/{baseline}/docs/**)",
  "Edit(/{baseline}/.github/**)",
  "Write(/{baseline}/.github/**)",
  "Edit(/{office}/*.md)",
  "Write(/{office}/*.md)",
  "Edit(/{office}/leader/**)",
  "Write(/{office}/leader/**)",
  "Edit(/{office}/pipeline/**)",
  "Write(/{office}/pipeline/**)",
  "Edit(/{job}/task.json)",
  "Write(/{job}/task.json)",
  "Edit(/{job}/state.json)",
  "Write(/{job}/state.json)",
  "Edit(/{job}/pr.txt)",
  "Write(/{job}/pr.txt)",
  "Bash(gh api *-X*)",
  "Bash(gh api *--method*)",
  "Bash(gh api * -f*)",
  "Bash(gh api * -F*)",
  "Bash(gh api *--field*)",
  "Bash(gh api *--raw-field*)",
  "Bash(gh api *--input*)",
  "Bash(gh api *merge*)",
  "Bash(gh pr merge*)",
  "Edit(**/.git/**)",
  "Write(**/.git/**)",
  "Edit(**/.claude/**)",
  "Write(**/.claude/**)",
  "Edit(**/.mcp.json)",
  "Write(**/.mcp.json)",
  "Edit(~/**)",
  "Write(~/**)",
  "Bash(git *--output*)",
  "Bash(git *--upload-pack*)",
  "Bash(git *--receive-pack*)",
  "Bash(git *--exec*)",
  "Bash(git *--ext-diff*)",
  "Bash(git *--config*)",
  "Bash(git *--git-dir*)",
  "Bash(git *--work-tree*)",
  "Bash(git *-c *)",
  "Edit(**/.git)",
  "Write(**/.git)",
  "Edit(**/.gitmodules)",
  "Write(**/.gitmodules)",
  "Edit(**/.gitattributes)",
  "Write(**/.gitattributes)"
 ],
 "flow": [
  {
   "id": "design",
   "by": "claude",
   "session": "work",
   "prompt": "prompts/design.md",
   "out": "design.md",
   "tools": [
    "Read",
    "Write(/{job}/*.md)",
    "Edit(/{job}/*.md)",
    "Bash(git -C repo status*)",
    "Bash(git status*)",
    "Bash(git -C repo log*)",
    "Bash(git log*)"
   ]
  },
  {
   "id": "approve",
   "by": "human",
   "approve": "design.md"
  },
  {
   "id": "implement",
   "by": "claude",
   "session": "work",
   "prompt": "prompts/implement.md",
   "out": "implement.md",
   "tools": [
    "Read",
    "Write(/{job}/*.md)",
    "Edit(/{job}/*.md)",
    "Write(/{job}/repo/**)",
    "Edit(/{job}/repo/**)",
    "Bash(cd repo)",
    "Bash(git -C repo status*)",
    "Bash(git status*)",
    "Bash(git -C repo diff*)",
    "Bash(git diff*)",
    "Bash(git -C repo log*)",
    "Bash(git log*)",
    "Bash(git -C repo show*)",
    "Bash(git show*)",
    "Bash(git -C {job}/repo add*)",
    "Bash(git -C {job}/repo commit*)",
    "{allow}"
   ]
  },
  {
   "id": "check",
   "by": "script",
   "out": "check.md",
   "retry": "implement"
  },
  {
   "id": "pr",
   "by": "human",
   "wait": "pr.txt"
  },
  {
   "id": "review",
   "by": "claude",
   "session": "review",
   "prompt": "prompts/review.md",
   "out": "review.md",
   "tools": [
    "Read",
    "Write(/{job}/*.md)",
    "Edit(/{job}/*.md)",
    "Write(/{job}/repo/**)",
    "Edit(/{job}/repo/**)",
    "Bash(cd repo)",
    "Bash(python3 {baseline}/tools/review_preflight.py *)",
    "Bash(git -C repo status*)",
    "Bash(git status*)",
    "Bash(git -C repo diff*)",
    "Bash(git diff*)",
    "Bash(git -C repo log*)",
    "Bash(git log*)",
    "Bash(git -C repo show*)",
    "Bash(git show*)",
    "Bash(git -C repo fetch*)",
    "Bash(git fetch*)",
    "Bash(git -C {job}/repo add*)",
    "Bash(git -C {job}/repo commit*)",
    "Bash(git -C {job}/repo push origin HEAD)",
    "Bash(gh pr view*)",
    "Bash(gh pr checks*)",
    "Bash(gh pr edit*)",
    "Bash(gh api --paginate repos/*)",
    "{allow}"
   ]
  }
 ]
}
